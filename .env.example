# Copy this file to .env.local and fill in your keys. Never commit .env.local.

# Google AI Studio key for Gemma 4 (https://aistudio.google.com). Without it the app serves the demo lesson.
GEMINI_API_KEY=
# Optional: gemma-4-26b-a4b-it (default, faster) or gemma-4-31b-it (higher quality)
GEMMA_MODEL=gemma-4-26b-a4b-it

# OpenAI key, only used for illustrations (cover, stickers, cards without a real photo).
OPENAI_API_KEY=
# Optional: image model available on your account
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Set to 1 to always serve the cached demo lesson (useful on stage if the network fails).
DEMO_MODE=0
