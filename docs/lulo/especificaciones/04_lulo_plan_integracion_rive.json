{
  "schema_version": "1.0",
  "project": "Chispa",
  "character_id": "chispa-lulo",
  "type": "Rive design and runtime integration plan — not a .riv export",
  "recommended_setup": {
    "file_name": "lulo.riv",
    "artboard": "LuloMascot",
    "state_machine": "LuloController",
    "preferred_runtime_interface": "Data Binding (View Model) where supported",
    "view_model_proposal": {
      "name": "LuloState",
      "properties": [
        {
          "name": "scene",
          "type": "string",
          "example": "home"
        },
        {
          "name": "isSpeaking",
          "type": "boolean",
          "example": false
        },
        {
          "name": "isLoading",
          "type": "boolean",
          "example": false
        },
        {
          "name": "celebrateSignal",
          "type": "trigger_or_equivalent",
          "example": "fire when reward earned"
        }
      ],
      "note": "Las propiedades son un CONTRATO PROPUESTO, no un esquema JSON importable por el editor."
    }
  },
  "states": [
    {
      "id": "home",
      "visual": "idle + wave on entrance",
      "animation": "idle"
    },
    {
      "id": "loading",
      "visual": "thinking",
      "animation": "thinking"
    },
    {
      "id": "lesson",
      "visual": "explain, combine with talking when speaking",
      "animation": "explain"
    },
    {
      "id": "quiz",
      "visual": "quiz_prompt then idle",
      "animation": "quiz_prompt"
    },
    {
      "id": "encourage",
      "visual": "reassure, then explain",
      "animation": "reassure"
    },
    {
      "id": "reward",
      "visual": "celebrate once then idle",
      "animation": "celebrate"
    }
  ],
  "frontend_event_mapping": [
    {
      "ui_event": "APP_READY",
      "scene": "home",
      "animation": "wave"
    },
    {
      "ui_event": "LESSON_REQUESTED",
      "scene": "loading",
      "animation": "thinking"
    },
    {
      "ui_event": "LESSON_CARD_SHOWN",
      "scene": "lesson",
      "animation": "explain"
    },
    {
      "ui_event": "SPEECH_STARTED",
      "effect": "start talking animation / set isSpeaking=true"
    },
    {
      "ui_event": "SPEECH_ENDED",
      "effect": "stop talking animation / set isSpeaking=false"
    },
    {
      "ui_event": "QUIZ_STARTED",
      "scene": "quiz",
      "animation": "quiz_prompt"
    },
    {
      "ui_event": "CHILD_NEEDS_HELP",
      "scene": "encourage",
      "animation": "reassure"
    },
    {
      "ui_event": "REWARD_EARNED",
      "scene": "reward",
      "animation": "celebrate"
    }
  ],
  "asset_checklist": [
